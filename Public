<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width,initial-scale=1,maximum-scale=1"
>

<title>JATUB AI</title>

<style>

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

:root {
  --bg: #ffffff;
  --panel: #f7f7f7;
  --panel2: #eeeeee;
  --text: #111111;
  --muted: #666666;
  --border: #dddddd;
  --user: #eeeeee;
}

body.dark {
  --bg: #212121;
  --panel: #171717;
  --panel2: #303030;
  --text: #ffffff;
  --muted: #aaaaaa;
  --border: #3d3d3d;
  --user: #303030;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family:
    Arial,
    Helvetica,
    sans-serif;
}

button,
textarea,
input {
  font: inherit;
}

button {
  color: inherit;
}


/* HEADER */

.header {
  height: 58px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 12px;
  border-bottom: 1px solid var(--border);
}

.icon {
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  font-size: 23px;
}

.icon:active {
  background: var(--panel2);
}

.title {
  flex: 1;
  font-weight: bold;
  font-size: 17px;
}

.new-chat {
  width: 42px;
  height: 42px;
  border: 1px solid var(--border);
  background: var(--panel);
  border-radius: 13px;
  font-size: 23px;
}


/* CHAT */

.chat {
  height: calc(100vh - 58px);
  overflow-y: auto;
  padding:
    20px
    12px
    125px;
}

.welcome {
  min-height: 65vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.logo {
  width: 64px;
  height: 64px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--panel2);
  font-size: 32px;
  margin-bottom: 18px;
}

.welcome h1 {
  margin: 0 0 8px;
  font-size: 28px;
}

.welcome p {
  color: var(--muted);
}


/* MESSAGES */

.message {
  max-width: 850px;
  margin:
    0 auto
    18px;
  display: flex;
}

.message.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 88%;
  padding: 12px 15px;
  border-radius: 18px;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.user .bubble {
  background: var(--user);
}

.assistant .bubble {
  background: transparent;
}

.bubble img {
  display: block;
  width: min(100%, 600px);
  border-radius: 15px;
}


/* SUGGESTIONS */

.suggestions {
  max-width: 850px;
  margin: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.suggestion {
  padding: 14px;
  border:
    1px solid
    var(--border);
  background: var(--panel);
  border-radius: 15px;
  text-align: left;
}


/* COMPOSER */

.composer-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10px 12px 14px;
  background:
    linear-gradient(
      transparent,
      var(--bg) 30%
    );
}

.composer {
  max-width: 850px;
  margin: auto;
  display: flex;
  align-items: flex-end;
  gap: 6px;
  padding: 7px;
  border:
    1px solid
    var(--border);
  background: var(--panel);
  border-radius: 24px;
}

textarea {
  flex: 1;
  resize: none;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  padding: 11px 5px;
  min-height: 42px;
  max-height: 140px;
}

textarea::placeholder {
  color: var(--muted);
}

.send {
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 50%;
  background: var(--text);
  color: var(--bg);
  font-size: 20px;
}


/* DRAWER */

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.5);
  display: none;
  z-index: 20;
}

.overlay.show {
  display: block;
}

.drawer {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: min(310px,85vw);
  background: var(--panel);
  z-index: 21;
  transform: translateX(-100%);
  transition: .2s;
  padding: 14px;
  display: flex;
  flex-direction: column;
}

.drawer.show {
  transform: translateX(0);
}

.drawer-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  font-weight: bold;
  font-size: 19px;
}

.search {
  width: 100%;
  margin: 14px 0 8px;
  padding: 12px;
  border:
    1px solid
    var(--border);
  border-radius: 12px;
  outline: none;
  background: var(--bg);
  color: var(--text);
}

.drawer-button {
  border: 0;
  background: transparent;
  padding: 12px;
  text-align: left;
  border-radius: 10px;
}

.drawer-button:active {
  background: var(--panel2);
}

.section {
  color: var(--muted);
  font-size: 12px;
  margin: 15px 10px 5px;
}

.history {
  flex: 1;
  overflow-y: auto;
}

.history-item {
  padding: 11px;
  border-radius: 10px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-item:active {
  background: var(--panel2);
}


/* MENU */

.menu {
  position: fixed;
  left: 12px;
  bottom: 80px;
  min-width: 200px;
  background: var(--panel);
  border:
    1px solid
    var(--border);
  border-radius: 17px;
  padding: 7px;
  display: none;
  z-index: 15;
  box-shadow:
    0 10px 40px
    rgba(0,0,0,.25);
}

.menu.show {
  display: block;
}

.menu button {
  width: 100%;
  padding: 12px;
  border: 0;
  background: transparent;
  text-align: left;
  border-radius: 10px;
}

.menu button:active {
  background: var(--panel2);
}


/* TYPING */

.typing {
  display: flex;
  gap: 5px;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--muted);
  animation:
    blink 1.2s infinite;
}

.dot:nth-child(2) {
  animation-delay: .15s;
}

.dot:nth-child(3) {
  animation-delay: .3s;
}

@keyframes blink {

  0%,70%,100% {
    opacity: .25;
  }

  35% {
    opacity: 1;
  }

}


/* MOBILE */

@media(max-width:600px) {

  .suggestions {
    grid-template-columns: 1fr;
  }

  .bubble {
    max-width: 94%;
  }

}

</style>

</head>

<body>

<header class="header">

<button
  class="icon"
  id="drawerButton">
  ☰
</button>

<div class="title">
  JATUB AI
</div>

<button
  class="new-chat"
  id="newChat">
  ＋
</button>

</header>


<main
  class="chat"
  id="chat">

<div
  class="welcome"
  id="welcome">

<div class="logo">
  ✦
</div>

<h1>
  How can I help?
</h1>

<p>
  Ask JATUB AI anything.
</p>

</div>


<div
  class="suggestions"
  id="suggestions">

<button class="suggestion">
  Explain something difficult simply
</button>

<button class="suggestion">
  Help me write something
</button>

<button class="suggestion">
  Generate an image
</button>

<button class="suggestion">
  Help me with coding
</button>

</div>

</main>


<div class="composer-wrap">

<div class="composer">

<button
  class="icon"
  id="plus">
  ＋
</button>

<textarea
  id="input"
  rows="1"
  placeholder="Message JATUB AI..."
></textarea>

<button
  class="send"
  id="send">
  ↑
</button>

</div>

</div>


<!-- DRAWER -->

<div
  class="overlay"
  id="overlay">
</div>

<aside
  class="drawer"
  id="drawer">

<div class="drawer-top">

<div class="brand">
  JATUB AI
</div>

<button
  class="icon"
  id="close">
  ×
</button>

</div>


<button
  class="drawer-button"
  id="drawerNew">
  ＋ New chat
</button>


<input
  class="search"
  id="search"
  placeholder="Search chats">


<button class="drawer-button">
  🖼 Images
</button>

<button class="drawer-button">
  📚 Library
</button>

<button class="drawer-button">
  📁 Projects
</button>

<button class="drawer-button">
  ⚙ Settings
</button>


<div class="section">
  RECENTS
</div>

<div
  class="history"
  id="history">
</div>


<button
  class="drawer-button"
  id="theme">
  ☀ / ☾ Theme
</button>

</aside>


<!-- PLUS MENU -->

<div
  class="menu"
  id="menu">

<button id="image">
  🖼 Generate image
</button>

<button id="think">
  🧠 Think harder
</button>

<button id="voice">
  🎙 Voice input
</button>

</div>


<script>

const chat =
  document.getElementById("chat");

const input =
  document.getElementById("input");

const send =
  document.getElementById("send");

const welcome =
  document.getElementById("welcome");

const suggestions =
  document.getElementById("suggestions");

const menu =
  document.getElementById("menu");

const drawer =
  document.getElementById("drawer");

const overlay =
  document.getElementById("overlay");

const history =
  document.getElementById("history");

let messages = [];

let thinkHarder = false;


/* =========================
   STORAGE
========================= */

function save() {

  localStorage.setItem(
    "jatub_messages",
    JSON.stringify(messages)
  );

}


function load() {

  try {

    const saved =
      localStorage.getItem(
        "jatub_messages"
      );

    if (!saved) return;

    messages =
      JSON.parse(saved);

    messages.forEach(
      message => {

        showMessage(
          message.role,
          message.content,
          message.image
        );

      }
    );

    if (messages.length) {

      welcome.style.display =
        "none";

      suggestions.style.display =
        "none";

    }

  } catch {

    messages = [];

  }

}


/* =========================
   MESSAGE
========================= */

function showMessage(
  role,
  content,
  image = null
) {

  const wrapper =
    document.createElement("div");

  wrapper.className =
    "message " + role;

  const bubble =
    document.createElement("div");

  bubble.className =
    "bubble";

  if (content) {

    bubble.textContent =
      content;

  }

  if (image) {

    const img =
      document.createElement("img");

    img.src =
      image;

    bubble.appendChild(img);

  }

  wrapper.appendChild(
    bubble
  );

  chat.appendChild(
    wrapper
  );

  chat.scrollTop =
    chat.scrollHeight;

}


function addMessage(
  role,
  content,
  image = null
) {

  messages.push({
    role,
    content,
    image
  });

  save();

  showMessage(
    role,
    content,
    image
  );

}


/* =========================
   TYPING
========================= */

function typing() {

  const wrapper =
    document.createElement("div");

  wrapper.id =
    "typing";

  wrapper.className =
    "message assistant";

  wrapper.innerHTML = `
    <div class="bubble">
      <div class="typing">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </div>
    </div>
  `;

  chat.appendChild(
    wrapper
  );

  chat.scrollTop =
    chat.scrollHeight;

}


function removeTyping() {

  document
    .getElementById("typing")
    ?.remove();

}


/* =========================
   CHAT API
========================= */

async function sendMessage() {

  const text =
    input.value.trim();

  if (!text) return;

  input.value = "";

  resize();

  welcome.style.display =
    "none";

  suggestions.style.display =
    "none";

  addMessage(
    "user",
    text
  );

  typing();

  send.disabled = true;

  try {

    const previous =
      messages
        .slice(0, -1)
        .filter(x =>
          x.role === "user" ||
          x.role === "assistant"
        )
        .map(x => ({
          role: x.role,
          content: x.content
        }));


    const response =
      await fetch(
        "/api/chat",
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body: JSON.stringify({

            message: text,

            history: previous,

            thinkHarder

          })

        }
      );


    const data =
      await response.json();


    if (!response.ok ||
        !data.ok) {

      throw new Error(
        data.error ||
        "AI request failed."
      );

    }


    removeTyping();

    addMessage(
      "assistant",
      data.text
    );


  } catch(error) {

    removeTyping();

    addMessage(
      "assistant",
      "❌ " +
      (
        error.message ||
        "Connection failed."
      )
    );

  } finally {

    send.disabled =
      false;

  }

}


/* =========================
   IMAGE
========================= */

async function generateImage() {

  const prompt =
    input.value.trim();

  if (!prompt) {

    input.focus();

    return;

  }

  input.value = "";

  resize();

  menu.classList.remove(
    "show"
  );

  welcome.style.display =
    "none";

  suggestions.style.display =
    "none";

  addMessage(
    "user",
    "Generate an image: " +
    prompt
  );

  typing();

  try {

    const response =
      await fetch(
        "/api/image",
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body: JSON.stringify({
            prompt
          })

        }
      );


    const data =
      await response.json();


    if (!response.ok ||
        !data.ok) {

      throw new Error(
        data.error ||
        "Image generation failed."
      );

    }


    removeTyping();

    addMessage(
      "assistant",
      "",
      data.image
    );


  } catch(error) {

    removeTyping();

    addMessage(
      "assistant",
      "❌ Image generation failed: " +
      error.message
    );

  }

}


/* =========================
   NEW CHAT
========================= */

function newChat() {

  messages = [];

  localStorage.removeItem(
    "jatub_messages"
  );

  chat.innerHTML = "";

  chat.appendChild(
    welcome
  );

  chat.appendChild(
    suggestions
  );

  welcome.style.display =
    "flex";

  suggestions.style.display =
    "grid";

  closeDrawer();

}


/* =========================
   DRAWER
========================= */

function openDrawer() {

  drawer.classList.add(
    "show"
  );

  overlay.classList.add(
    "show"
  );

  renderHistory();

}


function closeDrawer() {

  drawer.classList.remove(
    "show"
  );

  overlay.classList.remove(
    "show"
  );

}


function renderHistory() {

  history.innerHTML = "";

  messages
    .filter(x =>
      x.role === "user"
    )
    .slice()
    .reverse()
    .slice(0,30)
    .forEach(x => {

      const item =
        document.createElement(
          "div"
        );

      item.className =
        "history-item";

      item.textContent =
        x.content;

      history.appendChild(
        item
      );

    });

}


/* =========================
   THEME
========================= */

if (
  localStorage.getItem(
    "jatub_theme"
  ) === "dark"
) {

  document.body.classList.add(
    "dark"
  );

}


document
  .getElementById("theme")
  .onclick = () => {

    document.body.classList.toggle(
      "dark"
    );

    localStorage.setItem(
      "jatub_theme",
      document.body.classList.contains(
        "dark"
      )
        ? "dark"
        : "light"
    );

  };


/* =========================
   RESIZE
========================= */

function resize() {

  input.style.height =
    "auto";

  input.style.height =
    Math.min(
      input.scrollHeight,
      140
    ) + "px";

}

input.addEventListener(
  "input",
  resize
);


/* =========================
   BUTTONS
========================= */

send.onclick =
  sendMessage;


input.addEventListener(
  "keydown",
  e => {

    if (
      e.key === "Enter" &&
      !e.shiftKey
    ) {

      e.preventDefault();

      sendMessage();

    }

  }
);


document
  .getElementById("plus")
  .onclick = () => {

    menu.classList.toggle(
      "show"
    );

  };


document
  .getElementById("image")
  .onclick =
  generateImage;


document
  .getElementById("think")
  .onclick = () => {

    thinkHarder =
      !thinkHarder;

    document
      .getElementById("think")
      .textContent =
      thinkHarder
        ? "🧠 Think harder ✓"
        : "🧠 Think harder";

  };


/* =========================
   VOICE
========================= */

document
  .getElementById("voice")
  .onclick = () => {

    menu.classList.remove(
      "show"
    );

    const Speech =
      window.SpeechRecognition ||
      window.webkitSpeechRecognition;

    if (!Speech) {

      alert(
        "Voice input is not supported here."
      );

      return;

    }

    const recognition =
      new Speech();

    recognition.lang =
      "en-US";

    recognition.interimResults =
      false;

    recognition.onresult =
      event => {

        input.value =
          event
            .results[0][0]
            .transcript;

        resize();

      };

    recognition.start();

  };


/* =========================
   DRAWER EVENTS
========================= */

document
  .getElementById("drawerButton")
  .onclick =
  openDrawer;


document
  .getElementById("close")
  .onclick =
  closeDrawer;


overlay.onclick =
  closeDrawer;


document
  .getElementById("newChat")
  .onclick =
  newChat;


document
  .getElementById("drawerNew")
  .onclick =
  newChat;


/* =========================
   SUGGESTIONS
========================= */

document
  .querySelectorAll(
    ".suggestion"
  )
  .forEach(button => {

    button.onclick = () => {

      const text =
        button.textContent.trim();

      if (
        text
          .toLowerCase()
          .includes(
            "generate an image"
          )
      ) {

        input.value =
          "Create an image of ";

      } else {

        input.value =
          text;

      }

      resize();

      input.focus();

    };

  });


/* =========================
   SEARCH
========================= */

document
  .getElementById("search")
  .addEventListener(
    "input",
    e => {

      const query =
        e.target.value
          .toLowerCase();

      document
        .querySelectorAll(
          ".history-item"
        )
        .forEach(item => {

          item.style.display =
            item.textContent
              .toLowerCase()
              .includes(query)
                ? ""
                : "none";

        });

    }
  );


/* =========================
   START
========================= */

load();

</script>

</body>
</html>

